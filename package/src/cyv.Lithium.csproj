<Project Sdk="Microsoft.NET.Sdk">
	<ItemGroup>
		<PackageReference Include="cyv.Lithium.Core" Version="$(CoreVersion)" />
		<PackageReference Include="cyv.Lithium.Defs" Version="$(DefsVersion)" />
		<PackageReference Include="cyv.Lithium.Strings" Version="$(StringsVersion)" />

		<PackageReference Include="Fluent.Net" Version="1.0.63" />
	</ItemGroup>

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net9.0</TargetFramework>

		<PackageId>cyv.Lithium</PackageId>
		<Authors>Chris Grassi</Authors>
		<Description>Library for dynamically loading XML into objects at runtime.</Description>

		<RepositoryUrl>https://github.com/cyv-cg/lithium</RepositoryUrl>
		<PackageProjectUrl>https://github.com/cyv-cg/lithium</PackageProjectUrl>
		<RespositoryType>git</RespositoryType>
		<Copyright>Copyright (c) Chris Grassi 2026</Copyright>
		<RepositoryBranch>main</RepositoryBranch>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<NoPackageAnalysis>true</NoPackageAnalysis>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>
